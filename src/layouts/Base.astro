---
import "../../assets/styles/sarum.css";
import "../styles/app.css";

interface Props {
  title: string;
  description?: string;
  /** current nav path, e.g. "/doa/" */
  current?: string;
  /** focused mode (Mode Antre): keeps header + Aa, hides nav links, footer and tab bar */
  minimal?: boolean;
}

const { title, description = "Panduan Sakramen Tobat (Pengakuan Dosa) dari Keuskupan Surabaya.", current = "", minimal = false } = Astro.props;

// The brand is the home link (universal convention), so no "Beranda" item;
// the explainer is "Pengantar", matching its card on the home page — a nav
// item repeating the brand's own words pointed somewhere else read as a bug.
const NAV = [
  ["/sakramen-tobat/", "Pengantar"],
  ["/lima-langkah/", "Lima Langkah"],
  ["/doa/", "Doa"],
  ["/pemeriksaan-batin/", "Pemeriksaan Batin"],
  ["/tata-cara/", "Tata Cara"],
  ["/tentang/", "Tentang"],
] as const;

/* Bottom tab bar (mobile): the four places a penitent actually stands in,
   plus a "Lainnya" sheet for the rest. Glyphs echo the versal chips. */
const TABS = [
  ["/", "B", "Beranda"],
  ["/doa/", "D", "Doa"],
  ["/pemeriksaan-batin/", "P", "Batin"],
  ["/tata-cara/", "T", "Tata Cara"],
] as const;

const MORE = [
  ["/sakramen-tobat/", "Apa itu Sakramen Tobat"],
  ["/lima-langkah/", "Lima Langkah"],
  ["/antre/", "Mode Antre"],
  ["/selesai/", "Selesai · Penitensi"],
  ["/tentang/", "Tentang"],
] as const;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F9F5EA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#100E0A" media="(prefers-color-scheme: dark)" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/og-1200x630.jpg", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Apply saved reading options before paint (theme auto → follows OS).
      {
        const root = document.documentElement;
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") root.dataset.theme = t;
        const fs = localStorage.getItem("pd-fs");
        if (fs && fs !== "1") root.dataset.fs = fs;
        const m = localStorage.getItem("pd-measure");
        if (m) root.dataset.measure = m;
        if (localStorage.getItem("pd-contrast")) root.dataset.contrast = "high";
      }
    </script>
  </head>
  <body class:list={[minimal ? "minimal" : "has-tabs"]}>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/"><span class="versal-mini" aria-hidden="true">T</span>Sakramen Tobat</a>
        <nav class="site-nav" aria-label="Navigasi">
          {NAV.map(([href, label]) => (
            <a href={href} aria-current={href === current ? "page" : undefined}>{label}</a>
          ))}
        </nav>
        <button class="opt-btn" id="view-btn" aria-label="Pilihan baca">Aa</button>
      </div>
    </header>

    <dialog class="view-dialog" id="view-dialog" aria-label="Pilihan baca">
      <h2 class="rubric">Pilihan Baca</h2>
      <div class="vrow">
        <span>Ukuran teks</span>
        <span class="seg">
          <button type="button" id="fs-dec" aria-label="Perkecil teks">A−</button>
          <span class="fs-dots" id="fs-dots" aria-hidden="true"></span>
          <button type="button" id="fs-inc" aria-label="Perbesar teks">A+</button>
        </span>
      </div>
      <div class="vrow">
        <span>Tema</span>
        <span class="seg" id="theme-seg">
          <button type="button" data-set-theme="auto">Otomatis</button>
          <button type="button" data-set-theme="light">Terang</button>
          <button type="button" data-set-theme="dark">Gelap</button>
        </span>
      </div>
      <div class="vrow">
        <span>Kontras</span>
        <span class="seg" id="contrast-seg">
          <button type="button" data-set-contrast="">Normal</button>
          <button type="button" data-set-contrast="high">Tinggi</button>
        </span>
      </div>
      <div class="vrow">
        <span>Panjang baris</span>
        <span class="seg" id="measure-seg">
          <button type="button" data-set-measure="">Sempit</button>
          <button type="button" data-set-measure="wide">Lebar</button>
        </span>
      </div>
      <div class="vrow" id="wake-row" hidden>
        <span>Jaga layar menyala</span>
        <span class="seg"><button type="button" id="wake-btn" aria-pressed="false">Mati</button></span>
      </div>
      <p class="vnote">Seluruh panduan tersimpan di perangkat ini dan tetap dapat dibuka tanpa koneksi.</p>
    </dialog>

    <slot />

    {!minimal && (
      <>
      <footer class="site-footer">
        <div class="wrap">
          <p class="gloss"><a href="/tentang/">Kolofon</a></p>
        </div>
      </footer>

      <nav class="tab-bar" aria-label="Navigasi bawah">
        {TABS.map(([href, glyph, label]) => (
          <a href={href} aria-current={href === current ? "page" : undefined}>
            <span class="tab-glyph" aria-hidden="true">{glyph}</span>
            <span>{label}</span>
          </a>
        ))}
        <button type="button" id="more-btn" aria-haspopup="dialog">
          <span class="tab-glyph" aria-hidden="true">⋯</span>
          <span>Lainnya</span>
        </button>
      </nav>

      <dialog class="view-dialog" id="more-dialog" aria-label="Halaman lainnya">
        <h2 class="rubric">Lainnya</h2>
        <nav class="more-list">
          {MORE.map(([href, label]) => (
            <a href={href} aria-current={href === current ? "page" : undefined}>{label}</a>
          ))}
        </nav>
      </dialog>
      </>
    )}

    <script>
      const root = document.documentElement;
      const $ = (id: string) => document.getElementById(id)!;

      /* ---------- reading options dialog ---------- */
      const viewDialog = $("view-dialog") as HTMLDialogElement;
      $("view-btn").addEventListener("click", () => viewDialog.showModal());
      viewDialog.addEventListener("click", (e) => { if (e.target === viewDialog) viewDialog.close(); });

      /* ---------- "Lainnya" sheet (tab bar) ---------- */
      const moreBtn = document.getElementById("more-btn");
      const moreDialog = document.getElementById("more-dialog") as HTMLDialogElement | null;
      if (moreBtn && moreDialog) {
        moreBtn.addEventListener("click", () => moreDialog.showModal());
        moreDialog.addEventListener("click", (e) => { if (e.target === moreDialog) moreDialog.close(); });
      }

      /* text size */
      const FS_MAX = 6;
      const paintFs = () => {
        const v = parseInt(root.dataset.fs ?? "1") || 1;
        $("fs-dots").textContent = "·".repeat(v + 1).split("").join(" ");
      };
      const setFs = (d: number) => {
        const v = Math.min(FS_MAX, Math.max(0, (parseInt(root.dataset.fs ?? "1") || 1) + d));
        root.dataset.fs = String(v);
        localStorage.setItem("pd-fs", String(v));
        paintFs();
      };
      $("fs-dec").addEventListener("click", () => setFs(-1));
      $("fs-inc").addEventListener("click", () => setFs(1));
      paintFs();

      /* theme: auto follows the reader's own day and night */
      const osLight = matchMedia("(prefers-color-scheme: light)");
      const themePref = () => localStorage.getItem("theme") ?? "auto";
      const paintTheme = () => {
        const pref = themePref();
        if (pref === "auto") delete root.dataset.theme;
        else root.dataset.theme = pref;
        document.querySelectorAll<HTMLButtonElement>("#theme-seg button").forEach((b) =>
          b.classList.toggle("on", b.dataset.setTheme === pref));
      };
      const setTheme = (t: string) => {
        if (t === "auto") localStorage.removeItem("theme");
        else localStorage.setItem("theme", t);
        paintTheme();
      };
      document.querySelectorAll<HTMLButtonElement>("#theme-seg button").forEach((b) =>
        b.addEventListener("click", () => setTheme(b.dataset.setTheme!)));
      osLight.addEventListener("change", () => { if (themePref() === "auto") paintTheme(); });
      paintTheme();

      /* contrast */
      const paintContrast = () => {
        document.querySelectorAll<HTMLButtonElement>("#contrast-seg button").forEach((b) =>
          b.classList.toggle("on", b.dataset.setContrast === (root.dataset.contrast ?? "")));
      };
      document.querySelectorAll<HTMLButtonElement>("#contrast-seg button").forEach((b) =>
        b.addEventListener("click", () => {
          if (b.dataset.setContrast) {
            root.dataset.contrast = b.dataset.setContrast;
            localStorage.setItem("pd-contrast", b.dataset.setContrast);
          } else {
            delete root.dataset.contrast;
            localStorage.removeItem("pd-contrast");
          }
          paintContrast();
        }));
      paintContrast();

      /* line length */
      const paintMeasure = () => {
        document.querySelectorAll<HTMLButtonElement>("#measure-seg button").forEach((b) =>
          b.classList.toggle("on", b.dataset.setMeasure === (root.dataset.measure ?? "")));
      };
      document.querySelectorAll<HTMLButtonElement>("#measure-seg button").forEach((b) =>
        b.addEventListener("click", () => {
          if (b.dataset.setMeasure) root.dataset.measure = b.dataset.setMeasure;
          else delete root.dataset.measure;
          localStorage.setItem("pd-measure", b.dataset.setMeasure!);
          paintMeasure();
        }));
      paintMeasure();

      /* keep screen awake (shown only where supported) */
      let wakeLock: WakeLockSentinel | null = null;
      const paintWake = () => {
        const b = $("wake-btn");
        const on = !!wakeLock;
        b.textContent = on ? "Menyala 🕯" : "Mati";
        b.setAttribute("aria-pressed", String(on));
        b.classList.toggle("on", on);
      };
      const acquireWake = async () => {
        try {
          wakeLock = await navigator.wakeLock.request("screen");
          wakeLock.addEventListener("release", () => { wakeLock = null; paintWake(); });
        } catch { localStorage.removeItem("pd-wake"); }
        paintWake();
      };
      if ("wakeLock" in navigator) {
        $("wake-row").hidden = false;
        $("wake-btn").addEventListener("click", async () => {
          if (wakeLock) { await wakeLock.release(); localStorage.removeItem("pd-wake"); }
          else { localStorage.setItem("pd-wake", "1"); await acquireWake(); }
        });
        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState === "visible" && localStorage.getItem("pd-wake")) acquireWake();
        });
        if (localStorage.getItem("pd-wake")) acquireWake();
      }

      /* offline support */
      if ("serviceWorker" in navigator) navigator.serviceWorker.register("/sw.js");

      /* Anonymous, aggregate page-open counter (functions/api/beacon.js).
         Sends the path and nothing else — never marks, notes, or dates,
         which stay in localStorage. Skipped for readers who signal
         Do Not Track / GPC, and during local dev. */
      const nav = navigator as Navigator & { globalPrivacyControl?: boolean };
      if (
        !["localhost", "127.0.0.1"].includes(location.hostname) &&
        nav.doNotTrack !== "1" && !nav.globalPrivacyControl &&
        "sendBeacon" in navigator
      ) {
        // "pwa" = launched from the home-screen icon (standalone display),
        // "view" = ordinary browser tab. Same anonymous payload either way.
        const standalone =
          matchMedia("(display-mode: standalone)").matches ||
          (navigator as Navigator & { standalone?: boolean }).standalone === true;
        navigator.sendBeacon("/api/beacon", JSON.stringify({ p: location.pathname, e: standalone ? "pwa" : "view" }));
        // Android/Chrome announces the install moment; iOS never does.
        window.addEventListener("appinstalled", () => {
          navigator.sendBeacon("/api/beacon", JSON.stringify({ p: location.pathname, e: "install" }));
        });
      }
    </script>
  </body>
</html>
