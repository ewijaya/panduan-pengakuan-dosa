---
import Base from "../layouts/Base.astro";
import FlowRail from "../components/FlowRail.astro";
import { loadBooklet } from "../lib/booklet";
import type { RitePart } from "../lib/booklet";
import { loadDoaTobat } from "../lib/supplement";
import { examTextsJson } from "../lib/exam-texts";

const b = loadBooklet();
const { petunjuk, steps } = b.tataCara;
const doaTobat = loadDoaTobat();

const renderPart = (p: RitePart) =>
  p.kind === "speech" ? "rite-speech" : p.kind === "action" ? "rite-action lectio" : "rite-note";

/* Anchor steps by their booklet text — THROW if the source drifts,
   same contract as src/lib/booklet.ts. */
const lastConfIdx = steps.findIndex((st) => st.umat.some((p) => p.text.includes("Pengakuan saya yang terakhir")));
const confessIdx = steps.findIndex((st) => st.umat.some((p) => p.text.includes("Dosa-dosa saya adalah")));
if (lastConfIdx === -1 || confessIdx === -1) throw new Error("[tata-cara] rite anchor steps not found");
---

<Base title="Tata Cara Pengakuan Dosa — Panduan Pengakuan Dosa" current="/tata-cara/">
  <main class="wrap">
    <FlowRail current="rite" />
    <p class="rubric page-kicker">Tata Cara</p>
    <h1 class="canticle page-title">Tata Cara Pengakuan Dosa</h1>

    <section class="folio">
      <h2 class="incipit">Petunjuk</h2>
      <div class="quire">
        {petunjuk.map((p, i) => (
          <p class="lectio" style="padding-block: calc(var(--space) * 2);">{i + 1}. {p}</p>
        ))}
      </div>
      <p class="gloss" style="margin-top: calc(var(--space) * 3);">Yang <span class="rubric" style="font-size: inherit;">merah</span> adalah yang dilakukan; yang <em>miring</em> adalah yang diucapkan.</p>
    </section>

    <div class="exam-controls" style="margin-top: calc(var(--space) * 6);">
      <span class="gloss" id="rite-pos" aria-live="polite"></span>
      <button class="btn btn--quiet" id="rite-toggle-all" type="button">Tampilkan semua</button>
      <a class="btn btn--quiet" href="/antre/" style="text-decoration: none;">Mode Antre</a>
    </div>
    <p class="gloss" style="margin-bottom: calc(var(--space) * 3);">Mode Antre: satu langkah per layar dengan huruf besar — untuk dibaca sambil menunggu giliran.</p>
    <div class="gathering" id="rite-gathering" aria-hidden="true">
      {steps.map(() => <i></i>)}
    </div>

    <div id="rite-root" class="rite-all">
      {steps.map((st, i) => (
        <section class="folio rite-step" data-step={i}>
          <h2 class="incipit"><span class="versal" aria-hidden="true">{i + 1}</span>Langkah {i + 1}</h2>
          {st.umat.length > 0 && (
            <div class="rite-voice">
              <p class="rubric">Umat</p>
              {st.umat.map((p) => (
                <>
                  <p class={renderPart(p)}>{p.text}</p>
                  {p.text.includes("PS. 25") && (
                    <details class="doa-tobat-fold">
                      <summary class="rubric">Doa Tobat (PS. 25)</summary>
                      <div class="oratio" lang="id">
                        {doaTobat.paragraphs.map((par) => <p>{par}</p>)}
                      </div>
                    </details>
                  )}
                </>
              ))}
              {i === lastConfIdx && <p class="gloss" id="last-ago" hidden></p>}
              {i === confessIdx && (
                <details class="catatan" id="catatan" hidden>
                  <summary class="rubric">Catatanku — tanda pemeriksaan batin</summary>
                  <ul id="catatan-list"></ul>
                  <p class="gloss">Hanya tersimpan di perangkat ini; terhapus otomatis setelah 24 jam.</p>
                </details>
              )}
            </div>
          )}
          {st.imam.length > 0 && (
            <div class="rite-voice">
              <p class="rubric">Imam</p>
              {st.imam.map((p) => (
                <p class={renderPart(p)}>{p.text}</p>
              ))}
            </div>
          )}
        </section>
      ))}
    </div>

    <div class="rite-controls" id="rite-controls" hidden>
      <button class="btn btn--quiet" id="rite-prev" type="button">← Sebelumnya</button>
      <span class="spacer"></span>
      <button class="btn" id="rite-next" type="button">Berikutnya →</button>
    </div>

    <p class="ornament" aria-hidden="true">• • •</p>
    <section class="folio">
      <p class="rubric">Selesai</p>
      <p class="lectio">Segera setelah keluar dari Ruang Pengakuan Dosa, lakukanlah Penitensimu, dan pergilah dalam damai, serta jangan berbuat dosa lagi.</p>
    </section>
    <a class="next-link" href="/selesai/">Lanjut · Selesai — Penitensi &amp; Doa Tobat →</a>
  </main>

  <script is:inline type="application/json" id="exam-texts" set:html={examTextsJson(b)} />

  <script>
    import { initRiteExtras } from "../lib/client/rite";

    const root = document.getElementById("rite-root")!;
    const stepsEls = [...document.querySelectorAll<HTMLElement>(".rite-step")];
    const leaves = document.querySelectorAll<HTMLElement>("#rite-gathering i");
    const pos = document.getElementById("rite-pos")!;
    const controls = document.getElementById("rite-controls")!;
    const toggleBtn = document.getElementById("rite-toggle-all")!;
    let cur = 0;
    let all = true;

    const prevBtn = document.getElementById("rite-prev") as HTMLButtonElement;
    const nextBtn = document.getElementById("rite-next") as HTMLButtonElement;
    const last = stepsEls.length - 1;

    function render() {
      root.classList.toggle("rite-all", all);
      controls.hidden = all;
      stepsEls.forEach((el, i) => el.classList.toggle("is-current", i === cur));
      leaves.forEach((l, i) => l.classList.toggle("is-done", all || i <= cur));
      pos.textContent = all ? `${stepsEls.length} langkah` : `Langkah ${cur + 1} dari ${stepsEls.length}`;
      toggleBtn.textContent = all ? "Satu per satu" : "Tampilkan semua";
      prevBtn.disabled = cur === 0;
      // the last step's "next" is the flow's next station, not a dead end
      nextBtn.textContent = cur === last ? "Selesai →" : "Berikutnya →";
    }

    toggleBtn.addEventListener("click", () => { all = !all; cur = 0; render(); if (!all) stepsEls[0].scrollIntoView({ block: "center" }); });
    prevBtn.addEventListener("click", () => { if (cur > 0) { cur--; render(); } });
    nextBtn.addEventListener("click", () => {
      if (cur === last) { location.href = "/selesai/"; return; }
      cur++;
      render();
    });

    render();
    initRiteExtras();
  </script>
</Base>
