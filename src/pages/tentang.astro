---
import Base from "../layouts/Base.astro";
import { loadBooklet } from "../lib/booklet";

const b = loadBooklet();
const c = b.credits;
---

<Base title="Tentang — Panduan Pengakuan Dosa" current="/tentang/">
  <main class="wrap">
    <p class="rubric page-kicker">Tentang panduan ini</p>
    <h1 class="canticle page-title">Kolofon</h1>

    <div class="stack">
      <section class="folio">
        <p class="lectio">Aplikasi ini adalah wujud digital dari buklet <strong>"Sakramen Tobat (Pengakuan Dosa)"</strong> yang diedarkan secara terbuka (<strong>GRATIS</strong>) oleh Keuskupan Surabaya. Seluruh teks diambil apa adanya dari buklet tersebut.</p>
      </section>

      <section class="folio">
        <h2 class="incipit"><span class="versal" aria-hidden="true">P</span>Penyunting</h2>
        <p class="lectio" style="font-size: var(--text-incipit); font-family: var(--font-display);">{c.penyunting}</p>
      </section>

      <section class="folio">
        <h2 class="incipit">Nihil Obstat</h2>
        {c.nihilObstat.map((l) => <p class="lectio">{l}</p>)}
      </section>

      <section class="folio">
        <h2 class="incipit">Imprimatur</h2>
        {c.imprimatur.map((l) => <p class="lectio">{l}</p>)}
      </section>

      <section class="folio">
        <h2 class="incipit">Penerbit</h2>
        {c.publisher.map((l) => <p class="lectio">{l}</p>)}
      </section>

      <section class="folio">
        <h2 class="incipit">Sampul</h2>
        {c.cover.map((l) => <p class="lectio"><em>{l}</em></p>)}
        <p class="gloss" style="margin-top: calc(var(--space) * 3);"><em>La confessione</em> (1838), Giuseppe Molteni — Gallerie d'Italia, Milano. Foto: Artgate Fondazione Cariplo (domain publik).</p>
      </section>

      <section class="folio">
        <h2 class="incipit">Privasi</h2>
        <p class="lectio">Tanda pada Pemeriksaan Batin, catatan penitensi, dan tanggal pengakuan disimpan hanya di penyimpanan lokal peramban Anda — tanpa akun dan tanpa server — dan dapat dihapus kapan saja dengan satu tombol. Tanda juga terhapus dengan sendirinya 24 jam kemudian, dan catatan penitensi setelah 7 hari.</p>
        <p class="lectio">Aplikasi hanya menghitung jumlah kunjungan halaman secara anonim dan agregat (tanpa cookie, tanpa identitas apa pun, menghormati sinyal <em>Do Not Track</em>). Isi tanda atau catatan Anda tidak pernah dikirim ke mana pun.</p>
      </section>

      <section class="folio">
        <h2 class="incipit">Kesetiaan teks</h2>
        <p class="lectio">Teks ditampilkan setia pada buklet cetak.</p>
      </section>

      <section class="folio">
        <h2 class="incipit">Kontak</h2>
        <p class="lectio">Pertanyaan, koreksi, atau masukan mengenai aplikasi ini: <a href="mailto:murainova.press@gmail.com">murainova.press@gmail.com</a></p>
      </section>
    </div>
  </main>
</Base>
