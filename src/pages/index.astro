---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import painting from "../../assets/artwork/la-confessione-molteni.jpg";
import { loadBooklet } from "../lib/booklet";

const b = loadBooklet();

const CARDS = [
  ["/sakramen-tobat/", "Pengantar", "Apa itu Sakramen Tobat", "Beberapa hal yang perlu kita ketahui dari Sakramen Tobat (Pengakuan Dosa)."],
  ["/lima-langkah/", "Panduan", "Lima Langkah", "Lima langkah untuk menjalankan Pengakuan Dosa yang baik."],
  ["/doa/", "Doa", "Doa Sebelum Pengakuan Dosa", "Mohonlah penerangan kepada Roh Kudus sebelum memeriksa batin."],
  ["/pemeriksaan-batin/", "Periksa Batin", "Pemeriksaan Batin", "Sepuluh Perintah Allah dan Kelima Perintah Gereja, dengan tanda yang tersimpan hanya di perangkat Anda."],
  ["/tata-cara/", "Tata Cara", "Tata Cara Pengakuan Dosa", "Dialog antara Umat dan Imam, langkah demi langkah."],
] as const;
---

<Base title="Sakramen Tobat (Pengakuan Dosa) — Panduan" current="/">
  <section class="hero-plate">
    <div class="wrap plate-grid">
      <figure class="plate">
        <Image src={painting} alt="Lukisan La confessione karya Giuseppe Molteni: seorang perempuan berlutut di ruang pengakuan dosa" widths={[480, 828, 1295]} sizes="(min-width: 900px) 40vw, 92vw" loading="eager" />
        <figcaption class="gloss"><em>La confessione</em> (1838) — Giuseppe Molteni</figcaption>
      </figure>
      <div class="plate-text">
        <p class="rubric">Keuskupan Surabaya · Diedarkan Secara Terbuka</p>
        <h1 class="canticle">{b.cover.title}</h1>
        <p class="plate-sub">{b.cover.subtitle}</p>
        <p class="penyunting rubric">Penyunting</p>
        <p class="penyunting-name">{b.credits.penyunting}</p>
        <p class="gloss">Nihil Obstat · Imprimatur — Keuskupan Surabaya, Juli 2019 (<a href="/tentang/">selengkapnya</a>)</p>
        <a class="btn plate-cta" href="/doa/">Mulai Pengakuan Dosa</a>
        <p class="gloss" style="margin-top: calc(var(--space) * 2);">Doa → Pemeriksaan Batin → Tata Cara → Selesai</p>
        <p class="gloss" id="last-conf" hidden></p>
      </div>
    </div>
  </section>

  <main class="wrap">
    <div class="folio" id="nudge" hidden>
      <p class="rubric">Undangan</p>
      <p class="lectio" id="nudge-text"></p>
    </div>

    <div class="folio">
      <p class="rubric">Privasi</p>
      <p>Panduan ini berjalan sepenuhnya di perangkat Anda. Tanda apa pun yang Anda buat pada Pemeriksaan Batin <strong>tersimpan hanya di perangkat ini</strong> — tanpa akun, tanpa server, tanpa pelacakan — dan dapat dihapus kapan saja dengan satu tombol.</p>
    </div>

    <div class="cards">
      {CARDS.map(([href, rubric, title, desc]) => (
        <a class="card-link" href={href}>
          <div class="folio">
            <p class="rubric">{rubric}</p>
            <h2 class="incipit">{title}</h2>
            <p class="desc lectio">{desc}</p>
          </div>
        </a>
      ))}
    </div>
  </main>

  <script>
    import { lastConfession, agoText, seasonalNudge } from "../lib/client/store";

    const last = lastConfession();
    if (last !== null) {
      const el = document.getElementById("last-conf")!;
      el.textContent = `Pengakuan dosa terakhir: ${agoText(last)}.`;
      el.hidden = false;
    }

    const nudge = seasonalNudge(last);
    if (nudge) {
      document.getElementById("nudge-text")!.textContent = nudge;
      document.getElementById("nudge")!.hidden = false;
    }
  </script>
</Base>
