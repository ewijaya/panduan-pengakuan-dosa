---
import Base from "../layouts/Base.astro";
import { loadBooklet } from "../lib/booklet";
import type { RitePart } from "../lib/booklet";
import { loadDoaTobat } from "../lib/supplement";
import { examTextsJson } from "../lib/exam-texts";

/**
 * Mode Antre — the rite for standing in the confession line: one step per
 * screen, large type, big controls, screen kept awake. Same booklet steps
 * as /tata-cara/, different posture.
 */

const b = loadBooklet();
const { steps } = b.tataCara;
const doaTobat = loadDoaTobat();

const renderPart = (p: RitePart) =>
  p.kind === "speech" ? "rite-speech" : p.kind === "action" ? "rite-action lectio" : "rite-note";

const lastConfIdx = steps.findIndex((st) => st.umat.some((p) => p.text.includes("Pengakuan saya yang terakhir")));
const confessIdx = steps.findIndex((st) => st.umat.some((p) => p.text.includes("Dosa-dosa saya adalah")));
if (lastConfIdx === -1 || confessIdx === -1) throw new Error("[antre] rite anchor steps not found");
---

<Base title="Mode Antre · Tata Cara Pengakuan Dosa" current="/tata-cara/" minimal>
  <main class="wrap antre">
    <div class="antre-top">
      <a class="gloss" href="/tata-cara/">← Keluar dari Mode Antre</a>
      <span class="gloss" id="antre-pos" aria-live="polite"></span>
    </div>
    <div class="gathering" id="antre-gathering" aria-hidden="true">
      {steps.map(() => <i></i>)}
    </div>

    <div id="rite-root">
      {steps.map((st, i) => (
        <section class="folio rite-step" data-step={i}>
          <h2 class="incipit"><span class="versal" aria-hidden="true">{i + 1}</span>Langkah {i + 1}</h2>
          {st.umat.length > 0 && (
            <div class="rite-voice">
              <p class="rubric">Umat</p>
              {st.umat.map((p) => (
                <>
                  <p class={renderPart(p)}>{p.text}</p>
                  {p.text.includes("PS. 25") && (
                    <details class="doa-tobat-fold">
                      <summary class="rubric">Doa Tobat (PS. 25)</summary>
                      <div class="oratio" lang="id">
                        {doaTobat.paragraphs.map((par) => <p>{par}</p>)}
                      </div>
                    </details>
                  )}
                </>
              ))}
              {i === lastConfIdx && <p class="gloss" id="last-ago" hidden></p>}
              {i === confessIdx && (
                <details class="catatan" id="catatan" hidden>
                  <summary class="rubric">Catatanku: tanda pemeriksaan batin</summary>
                  <ul id="catatan-list"></ul>
                  <p class="gloss">Hanya tersimpan di perangkat ini; terhapus otomatis setelah 24 jam.</p>
                </details>
              )}
            </div>
          )}
          {st.imam.length > 0 && (
            <div class="rite-voice">
              <p class="rubric">Imam</p>
              {st.imam.map((p) => (
                <p class={renderPart(p)}>{p.text}</p>
              ))}
            </div>
          )}
        </section>
      ))}
    </div>

    <div class="antre-controls">
      <button class="btn btn--quiet" id="antre-prev" type="button">← Sebelumnya</button>
      <button class="btn" id="antre-next" type="button">Berikutnya →</button>
    </div>
    <p class="gloss" id="antre-wake-note" style="margin-top: calc(var(--space) * 3);" hidden>Layar dijaga tetap menyala selama mode ini terbuka.</p>
  </main>

  <script is:inline type="application/json" id="exam-texts" set:html={examTextsJson(b)} />

  <script>
    import { initRiteExtras } from "../lib/client/rite";

    const stepsEls = [...document.querySelectorAll<HTMLElement>(".rite-step")];
    const leaves = document.querySelectorAll<HTMLElement>("#antre-gathering i");
    const pos = document.getElementById("antre-pos")!;
    const prev = document.getElementById("antre-prev") as HTMLButtonElement;
    const next = document.getElementById("antre-next") as HTMLButtonElement;
    const last = stepsEls.length - 1;
    let cur = 0;

    function render() {
      stepsEls.forEach((el, i) => el.classList.toggle("is-current", i === cur));
      leaves.forEach((l, i) => l.classList.toggle("is-done", i <= cur));
      pos.textContent = `Langkah ${cur + 1} dari ${stepsEls.length}`;
      prev.disabled = cur === 0;
      next.textContent = cur === last ? "Selesai →" : "Berikutnya →";
    }

    function go(d: number) {
      if (d > 0 && cur === last) { location.href = "/selesai/"; return; }
      cur = Math.min(last, Math.max(0, cur + d));
      render();
      stepsEls[cur].scrollIntoView({ block: "start", behavior: "auto" });
    }

    prev.addEventListener("click", () => go(-1));
    next.addEventListener("click", () => go(1));
    document.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") go(1);
      else if (e.key === "ArrowLeft") go(-1);
    });

    render();
    initRiteExtras();

    /* Keep the screen awake for the whole queue — scoped to this page,
       independent of the global Pilihan Baca toggle. */
    let lock: WakeLockSentinel | null = null;
    const acquire = async () => {
      try {
        lock = await navigator.wakeLock.request("screen");
        document.getElementById("antre-wake-note")!.hidden = false;
      } catch { /* denied or unsupported — the mode still works */ }
    };
    if ("wakeLock" in navigator) {
      acquire();
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") acquire();
      });
      window.addEventListener("pagehide", () => { lock?.release().catch(() => {}); });
    }
  </script>
</Base>

<style>
  /* Antre shows exactly one step; no "all" mode here. */
  .antre .rite-step { display: none; }
  .antre .rite-step.is-current { display: block; }
</style>
